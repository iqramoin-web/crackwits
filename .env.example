# Copy to .env.local for local overrides. Nothing here is secret and the site
# builds without any of it.

# Canonical site URL, used for absolute Open Graph / canonical links.
# Defaults to https://crackwits.com when unset.
NEXT_PUBLIC_SITE_URL=https://crackwits.com

# Set to 1 to hide the "Draft" badge and "AI placeholder" tags on case studies
# (e.g. for a client preview). Leave unset to show them.
NEXT_PUBLIC_HIDE_DRAFT_MARKERS=
